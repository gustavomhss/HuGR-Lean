+def pairwise_diff(iterable):
+    """Yield the difference ``b - a`` for each pair of consecutive items
+    ``a, b`` of *iterable*:
+
+        >>> list(pairwise_diff([1, 4, 9, 16]))
+        [3, 5, 7]
+
+    Iterables with fewer than two items yield nothing.
+
+    """
+    iterator = iter(iterable)
+    for a in iterator:
+        for b in iterator:
+            yield b - a
+            a = b
+
+
